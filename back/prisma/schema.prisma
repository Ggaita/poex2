generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ApplicationStatus {
  pending
  approved
  rejected
}
enum UserRole {
  admin
  empresa
}
enum ProfileEditMode {
  agency
  company
  mixed
}
enum EmailOutboxStatus {
  prepared
  sent
  failed
  cancelled
}
enum SpecialRequestKind {
  special_offer
  required_product
}
enum SpecialRequestStatus {
  pending
  in_review
  forwarded
  resolved
  rejected
}

model CompanyApplication {
  id              Int               @id @default(autoincrement())
  companyName     String
  contactName     String
  email           String            @unique
  phone           String?
  taxId           String?           @unique
  message         String?
  status          ApplicationStatus @default(pending)
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  profile         CompanyProfile?

  @@index([status])
  @@map("company_applications")
}
model AppUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownedProfiles CompanyProfile[]      @relation("ProfileOwner")
  profileAuditLogs CompanyProfileAuditLog[] @relation("ProfileAuditActor")
  createdEmailOutbox EmailOutbox[] @relation("EmailOutboxCreator")
  reviewedSpecialRequests SpecialRequest[] @relation("SpecialRequestReviewer")

  @@index([role])
  @@map("app_users")
}

model CompanyProfile {
  id                 Int         @id @default(autoincrement())
  applicationId      Int?        @unique
  ownerUserId        Int?
  slug               String      @unique
  companyName        String
  contactName        String
  contactEmail       String
  phone              String?
  taxId              String?
  description        String?
  sector             String?
  subSector          String?
  product            String?
  keywords           String?
  tariffPosition     String?
  exportDestinations String?
  awards             String?
  certifications     String?
  logoUrl            String?
  website            String?
  facebook           String?
  instagram          String?
  linkedin           String?
  youtube            String?
  otherLink          String?
  address            String?
  city               String?
  googleMapsEmbed    String?
  latitude           Float?
  longitude          Float?
  editMode           ProfileEditMode @default(mixed)
  isPublished        Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  application        CompanyApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  ownerUser          AppUser?     @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  visibilityRules    CompanyProfileVisibility[]
  auditLogs          CompanyProfileAuditLog[]
  products           CompanyProduct[]
  emailOutboxEntries EmailOutbox[] @relation("EmailOutboxRecipientProfile")

  @@index([isPublished])
  @@index([editMode])
  @@index([companyName])
  @@index([ownerUserId])
  @@map("company_profiles")
}

model CompanyProduct {
  id                      Int      @id @default(autoincrement())
  profileId               Int
  name                    String
  description             String?
  imageUrl                String?
  tariffPosition          String?
  isTariffPositionUnknown Boolean  @default(false)
  isAccepted              Boolean?
  rejectionMessage        String?
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  profile                 CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([tariffPosition])
  @@index([isAccepted])
  @@map("company_products")
}

model EmailTemplate {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  name            String
  description     String?
  subjectTemplate String
  bodyTemplate    String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  outboxEntries   EmailOutbox[] @relation("OutboxTemplate")

  @@map("email_templates")
}

model EmailOutbox {
  id               Int      @id @default(autoincrement())
  templateKey      String?
  triggerEvent     String
  recipientEmail   String
  recipientName    String?
  recipientProfileId Int?
  subject          String
  body             String
  status           EmailOutboxStatus @default(prepared)
  scheduledAt      DateTime?
  sentAt           DateTime?
  errorMessage     String?
  metadata         Json?
  createdByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  template         EmailTemplate? @relation("OutboxTemplate", fields: [templateKey], references: [key], onDelete: SetNull, onUpdate: Cascade)
  recipientProfile CompanyProfile? @relation("EmailOutboxRecipientProfile", fields: [recipientProfileId], references: [id], onDelete: SetNull)
  createdByUser    AppUser? @relation("EmailOutboxCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([templateKey])
  @@index([status, createdAt])
  @@index([recipientEmail])
  @@index([recipientProfileId])
  @@index([createdByUserId])
  @@map("email_outbox")
}

model SpecialRequest {
  id               Int      @id @default(autoincrement())
  kind             SpecialRequestKind
  sourceQuery      String?
  requestedProduct String
  details          String?
  requesterName    String
  requesterEmail   String
  requesterPhone   String?
  requesterCompany String?
  status           SpecialRequestStatus @default(pending)
  adminNotes       String?
  reviewedByUserId Int?
  reviewedByEmail  String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reviewedByUser   AppUser? @relation("SpecialRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterEmail])
  @@index([reviewedByUserId])
  @@map("special_requests")
}

model CompanyProfileVisibility {
  id        Int      @id @default(autoincrement())
  profileId Int
  fieldKey  String
  isVisible Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, fieldKey])
  @@index([profileId])
  @@map("company_profile_visibility")
}

model CompanyProfileAuditLog {
  id         Int      @id @default(autoincrement())
  profileId  Int
  actorUserId Int?
  actorEmail String?
  actorRole  UserRole?
  action     String
  fieldKey   String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  profile    CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actorUser  AppUser? @relation("ProfileAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([actorUserId])
  @@map("company_profile_audit_logs")
}
